---
import { HOME_EXPERIENCES } from '../../data';
---

<section id="experiences" class="py-24 bg-neutral-900 border-t border-b border-gold-500/10">
  <div class="max-w-7xl mx-auto px-6 md:px-12">
    
    <!-- Title Header -->
    <div class="text-center max-w-2xl mx-auto space-y-4 mb-16">
      <p class="font-mono text-xs uppercase tracking-[0.3em] text-gold-400 font-semibold">
        Signature Expeditions
      </p>
      <h2 class="font-serif text-3xl md:text-5xl text-gold-100 font-medium tracking-wide">
        Our Elite Expeditions
      </h2>
      <p class="font-sans text-sm md:text-base text-gold-100/50 leading-relaxed font-light">
        Masing-masing petualangan dirancang privat, berkelas tinggi, dan didedikasikan sepenuhnya untuk mewujudkan impian perjalanan tak terlupakan Anda di pulau dewata.
      </p>
    </div>

    <!-- 3-Column Luxury Deck -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8" id="signature-experiences-deck">
      {HOME_EXPERIENCES.map((exp) => (
        <div class="bg-neutral-950 border border-gold-400/10 rounded-lg overflow-hidden flex flex-col justify-between group shadow-xl hover:border-gold-400/30 transition-all duration-500 hover:shadow-2xl hover:shadow-black/60 text-left">
          
          <!-- Card Image -->
          <div class="relative h-64 overflow-hidden">
            <img
              src={exp.cardImage}
              alt={exp.title}
              loading="lazy"
              referrerpolicy="no-referrer"
              class="w-full h-full object-cover transition-transform duration-750 ease-out group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-neutral-950 via-neutral-950/20 to-transparent" />
            
            <div class="absolute bottom-4 left-4">
              <span class="inline-flex items-center bg-gold-400 text-neutral-950 text-[10px] font-mono font-extrabold uppercase tracking-widest px-3 py-1 rounded-sm">
                {exp.tagline}
              </span>
            </div>
          </div>

          <!-- Content Block -->
          <div class="p-6 md:p-8 flex-grow flex flex-col justify-between">
            <div class="space-y-6">
              <!-- Rating & Location Header -->
              <div class="flex items-center justify-between">
                <div class="flex items-center space-x-1 text-gold-400">
                  <span class="text-xs">★</span>
                  <span class="font-mono text-xs font-bold">{exp.rating}</span>
                  <span class="text-gold-200/40 text-[10px]">({exp.reviewCount} ulasan)</span>
                </div>
                <div class="flex items-center text-gold-200/50 text-[11px] font-mono gap-1">
                  <span>📍</span>
                  <span class="truncate max-w-[120px]">{exp.location.split(',')[0]}</span>
                </div>
              </div>

              <!-- Title & Description -->
              <div class="space-y-2">
                <h3 class="font-serif text-xl md:text-2xl text-gold-100 font-medium group-hover:text-gold-300 transition-colors">
                  {exp.title}
                </h3>
                <p class="text-gold-200/60 text-xs md:text-sm font-sans leading-relaxed line-clamp-3">
                  {exp.shortDesc}
                </p>
              </div>

              <!-- Highlights Bullet list -->
              <div class="space-y-3 pt-4 border-t border-gold-900/10">
                <h4 class="font-mono text-[10px] uppercase tracking-wider text-gold-400 font-bold flex items-center gap-1.5">
                  <span>✦</span>
                  <span>Sorotan Utama Paket</span>
                </h4>
                <ul class="space-y-2 text-xs text-gold-200/70 font-sans font-light">
                  {exp.highlights.slice(0, 3).map((high) => (
                    <li class="flex items-start gap-1.5">
                      <span class="text-gold-400 mt-0.5">•</span>
                      <span class="leading-relaxed line-clamp-2">{high}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <!-- Footer Section: Pricing and Book Now -->
            <div class="pt-6 mt-8 border-t border-gold-900/15 flex items-center justify-between gap-4">
              <div>
                <span class="font-mono text-[10px] uppercase tracking-widest text-gold-400/70 block">Investasi Liburan</span>
                <div class="flex items-baseline space-x-1">
                  <span class="font-mono text-2xl font-bold text-gold-400">${exp.pricePerPerson}</span>
                  <span class="text-[10px] text-gold-200/50 font-mono">/ orang</span>
                </div>
              </div>

              <button
                type="button"
                data-book-trigger="true"
                data-book-id={exp.id}
                class="bg-gold-400 hover:bg-gold-500 text-neutral-950 font-mono text-xs uppercase tracking-widest font-bold px-5 py-3 rounded-sm transition-all duration-300 shadow-md flex items-center gap-1.5 cursor-pointer active:scale-95"
              >
                <span>Book Now</span>
                <span>→</span>
              </button>
            </div>

          </div>

        </div>
      ))}
    </div>

  </div>
</section>
