---
const currentYear = new Date().getFullYear();
---

<footer id="footer" class="bg-neutral-950 border-t border-gold-400/20 pt-20 pb-10 text-left relative overflow-hidden">
  <div class="absolute bottom-0 right-0 w-96 h-96 bg-gold-500/[0.02] rounded-full filter blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-6 md:px-12 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-12 pb-16 border-b border-gold-900/10">
    
    <!-- Brand Description Column -->
    <div class="lg:col-span-4 space-y-6">
      <div class="flex items-center space-x-3.5">
        <img
          src="https://res.cloudinary.com/di6ziqvtp/image/upload/v1788783630/2dff2e80-f5bc-4bd7-8c97-2c99e0d9db5f.png"
          alt="Gede Bali Trip Logo"
          class="h-12 md:h-14 w-auto object-contain"
          referrerpolicy="no-referrer"
          loading="lazy"
        />
        <div class="flex flex-col">
          <span class="font-serif text-xl tracking-wider text-gold-200 uppercase font-bold">
            Gede Bali Trip
          </span>
          <span class="font-sans text-[9px] uppercase tracking-[0.25em] text-gold-400 font-semibold">
            Private Tour & Driver
          </span>
        </div>
      </div>
      <p class="font-sans text-xs md:text-sm text-gold-100/55 leading-relaxed font-light">
        Gede Bali Trip adalah penyedia layanan tur privat dan sewa kendaraan terbaik di Pulau Bali. Kami menghadirkan petualangan eksklusif, aman, dan fleksibel dengan armada prima serta supir lokal profesional berlisensi.
      </p>

      <div class="flex items-center space-x-3 text-gold-400 font-mono text-[9px] uppercase tracking-widest">
        <span>🧭</span>
        <span>Sustainable Luxury Tourism Registered</span>
      </div>
    </div>

    <!-- Contact Coordinates Column -->
    <div class="lg:col-span-3 space-y-4">
      <h4 class="font-serif text-base text-gold-200 tracking-wide font-semibold">
        Kantor Operasional
      </h4>
      <ul class="space-y-3 text-xs md:text-sm text-gold-100/60 font-light">
        <li class="flex items-start space-x-2.5">
          <span class="text-gold-400">📍</span>
          <span>Jalan Raya Seminyak No. 14A, Kuta, Badung, Bali 80361, Indonesia</span>
        </li>
        <li class="flex items-center space-x-2.5">
          <span class="text-gold-400">📞</span>
          <a href="https://wa.me/6281239633946" class="hover:text-gold-300 transition-colors">+62 812-3963-3946 (WhatsApp)</a>
        </li>
        <li class="flex items-center space-x-2.5">
          <span class="text-gold-400">✉️</span>
          <span>concierge@gedebalitrip.com</span>
        </li>
      </ul>
    </div>

    <!-- Navigation Links Column -->
    <div class="lg:col-span-2 space-y-4">
      <h4 class="font-serif text-base text-gold-200 tracking-wide font-semibold">
        Navigasi Cepat
      </h4>
      <ul class="space-y-2 text-xs font-mono uppercase tracking-wider text-gold-200/60">
        <li><a href="/" class="hover:text-gold-400 transition-colors">Beranda</a></li>
        <li><a href="/tours" class="hover:text-gold-400 transition-colors">Paket Tour</a></li>
        <li><a href="/rental" class="hover:text-gold-400 transition-colors">Sewa Kendaraan</a></li>
        <li><a href="/about" class="hover:text-gold-400 transition-colors">About Us</a></li>
        <li><a href="/gallery" class="hover:text-gold-400 transition-colors">Galeri Foto</a></li>
        <li><a href="/why-us" class="hover:text-gold-400 transition-colors">Why Choose Us</a></li>
        <li><a href="/contact" class="hover:text-gold-400 transition-colors">Kontak Kami</a></li>
      </ul>
    </div>

    <!-- Real-time Bali Clock & Weather -->
    <div class="lg:col-span-3 space-y-4">
      <h4 class="font-serif text-base text-gold-200 tracking-wide font-semibold">
        Waktu Lokal Bali
      </h4>
      <div class="bg-neutral-900/60 border border-gold-900/20 p-4 rounded-md space-y-2 font-mono">
        <div class="flex items-center justify-between text-xs text-gold-300/80">
          <span>Zona WITA (UTC+8)</span>
          <span id="footer-bali-clock" class="text-gold-400 font-bold text-sm">--:-- WITA</span>
        </div>
        <p class="text-[10px] text-gold-100/50">
          Pramutamu WhatsApp kami siaga melayani Anda 24 jam setiap hari.
        </p>
      </div>

      <!-- Quick WhatsApp Button -->
      <a
        href="https://wa.me/6281239633946?text=Halo%20Gede%20Bali%20Trip,%20saya%20ingin%20konsultasi%20paket%20tour%20Bali."
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 bg-emerald-500 hover:bg-emerald-600 text-neutral-950 font-mono text-[10px] uppercase tracking-widest font-bold px-4 py-3 rounded-sm transition-all shadow-md"
      >
        <span>Chat WhatsApp Resmi</span>
        <span>→</span>
      </a>
    </div>

  </div>

  <!-- Bottom Copyright -->
  <div class="max-w-7xl mx-auto px-6 md:px-12 pt-8 flex flex-col sm:flex-row items-center justify-between text-[11px] font-mono text-gold-200/40 gap-4">
    <p>© {currentYear} Gede Bali Trip. All rights reserved. Private Tour & Driver Services.</p>
    <div class="flex gap-6">
      <a href="/about" class="hover:text-gold-400 transition-colors">Privasi</a>
      <a href="/about" class="hover:text-gold-400 transition-colors">Syarat & Ketentuan</a>
      <a href="/contact" class="hover:text-gold-400 transition-colors">Bantuan 24/7</a>
    </div>
  </div>
</footer>

<script is:inline>
  (function () {
    const clockEl = document.getElementById('footer-bali-clock');
    function updateClock() {
      try {
        const now = new Date();
        const options = {
          timeZone: 'Asia/Makassar',
          hour: '2-digit',
          minute: '2-digit',
          hour12: true,
        };
        const formatter = new Intl.DateTimeFormat([], options);
        if (clockEl) {
          clockEl.textContent = formatter.format(now) + ' WITA';
        }
      } catch (e) {
        // Fallback
      }
    }
    updateClock();
    setInterval(updateClock, 30000);
  })();
</script>
