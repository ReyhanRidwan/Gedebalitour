---
import { GALLERY_PHOTOS } from '../../data';
---

<section id="gallery" class="pt-28 pb-24 bg-neutral-950 border-t border-gold-900/10 min-h-screen text-gold-100 font-sans">
  <div class="max-w-7xl mx-auto px-6 md:px-12">
    
    <!-- Gallery Headers -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-16">
      <div class="text-left space-y-4 max-w-xl">
        <p class="font-mono text-xs uppercase tracking-[0.3em] text-gold-400 font-semibold">
          Visual Narrative
        </p>
        <h1 class="font-serif text-3xl md:text-5xl lg:text-6xl text-gold-100 font-medium tracking-wide">
          Galeri Dokumentasi Petualangan
        </h1>
        <p class="font-sans text-sm text-gold-100/50 leading-relaxed font-light">
          Potret nyata keindahan pulau Bali dari sudut pandang terbaik. Mulai dari tebing purba Nusa Penida, kaldera Batur, hingga ketenangan rimba sakral Ubud.
        </p>
      </div>

      <!-- Filter Toggles -->
      <div class="flex flex-wrap gap-2 md:gap-4 pb-px" id="gallery-filters">
        <button
          type="button"
          class="gallery-filter-btn py-2 px-5 text-[10px] uppercase tracking-[0.2em] font-semibold transition-all border bg-gold-400 border-gold-400 text-neutral-950 font-bold cursor-pointer"
          data-category="all"
        >
          Semua Foto
        </button>
        <button
          type="button"
          class="gallery-filter-btn py-2 px-5 text-[10px] uppercase tracking-[0.2em] font-semibold transition-all border border-gold-900/25 text-gold-100/40 hover:text-gold-200 hover:border-gold-400/40 cursor-pointer"
          data-category="volcano"
        >
          Gunung Batur
        </button>
        <button
          type="button"
          class="gallery-filter-btn py-2 px-5 text-[10px] uppercase tracking-[0.2em] font-semibold transition-all border border-gold-900/25 text-gold-100/40 hover:text-gold-200 hover:border-gold-400/40 cursor-pointer"
          data-category="ocean"
        >
          Nusa Penida & Laut
        </button>
        <button
          type="button"
          class="gallery-filter-btn py-2 px-5 text-[10px] uppercase tracking-[0.2em] font-semibold transition-all border border-gold-900/25 text-gold-100/40 hover:text-gold-200 hover:border-gold-400/40 cursor-pointer"
          data-category="jungle"
        >
          Rimba Ubud
        </button>
      </div>
    </div>

    <!-- Photogrid layout -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" id="gallery-grid">
      {GALLERY_PHOTOS.map((photo, idx) => (
        <div
          class="gallery-item group relative aspect-[4/3] bg-neutral-900 border border-gold-900/10 rounded-sm overflow-hidden cursor-pointer shadow-lg hover:shadow-gold-500/5 hover:border-gold-400/30 transition-all duration-500"
          data-category={photo.category}
          data-url={photo.url}
          data-title={photo.title}
          data-index={idx}
        >
          <img
            src={photo.url}
            alt={photo.title}
            loading="lazy"
            referrerpolicy="no-referrer"
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
          />

          <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/35 to-transparent opacity-60 group-hover:opacity-90 transition-opacity duration-300"></div>

          <div class="absolute inset-0 p-6 flex flex-col justify-end text-left transform translate-y-2 group-hover:translate-y-0 transition-transform duration-300">
            <span class="font-mono text-[9px] uppercase tracking-widest text-gold-400 font-bold mb-1">
              {photo.category}
            </span>
            <h3 class="font-serif text-base text-gold-100 font-medium tracking-wide leading-tight">
              {photo.title}
            </h3>
            
            <div class="mt-3 flex items-center space-x-1 text-[10px] uppercase font-mono tracking-widest text-gold-300/60 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
              <span>🔍 Perbesar Foto</span>
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>

  <!-- Lightbox Modal -->
  <div id="gallery-lightbox" class="fixed inset-0 z-50 bg-black/95 flex items-center justify-center p-4 hidden">
    <button type="button" id="lightbox-close" class="absolute top-6 right-6 text-gold-300 hover:text-gold-100 text-3xl font-mono p-2">✕</button>
    <button type="button" id="lightbox-prev" class="absolute left-6 text-gold-300 hover:text-gold-100 text-4xl font-mono p-4">‹</button>
    <button type="button" id="lightbox-next" class="absolute right-6 text-gold-300 hover:text-gold-100 text-4xl font-mono p-4">›</button>

    <div class="max-w-4xl max-h-[85vh] flex flex-col items-center">
      <img id="lightbox-img" src="" alt="Enlarged" class="max-w-full max-h-[75vh] object-contain rounded shadow-2xl border border-gold-400/20" />
      <p id="lightbox-caption" class="text-gold-200 font-serif text-lg mt-4 text-center"></p>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    const filterBtns = document.querySelectorAll('.gallery-filter-btn');
    const items = document.querySelectorAll('.gallery-item');
    const lightbox = document.getElementById('gallery-lightbox');
    const lightboxImg = document.getElementById('lightbox-img');
    const lightboxCaption = document.getElementById('lightbox-caption');
    const closeBtn = document.getElementById('lightbox-close');
    const prevBtn = document.getElementById('lightbox-prev');
    const nextBtn = document.getElementById('lightbox-next');

    let currentIndex = 0;
    const photoData = Array.from(items).map((el) => ({
      url: el.getAttribute('data-url'),
      title: el.getAttribute('data-title'),
      category: el.getAttribute('data-category'),
    }));

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const cat = btn.getAttribute('data-category');
        filterBtns.forEach((b) => {
          b.classList.remove('bg-gold-400', 'border-gold-400', 'text-neutral-950', 'font-bold');
          b.classList.add('border-gold-900/25', 'text-gold-100/40');
        });
        btn.classList.add('bg-gold-400', 'border-gold-400', 'text-neutral-950', 'font-bold');
        btn.classList.remove('border-gold-900/25', 'text-gold-100/40');

        items.forEach((item) => {
          const itemCat = item.getAttribute('data-category');
          if (cat === 'all' || itemCat === cat) {
            item.classList.remove('hidden');
          } else {
            item.classList.add('hidden');
          }
        });
      });
    });

    function showLightbox(idx) {
      currentIndex = (idx + photoData.length) % photoData.length;
      if (lightboxImg) lightboxImg.src = photoData[currentIndex].url;
      if (lightboxCaption) lightboxCaption.textContent = photoData[currentIndex].title;
      lightbox?.classList.remove('hidden');
    }

    items.forEach((item, idx) => {
      item.addEventListener('click', () => showLightbox(idx));
    });

    closeBtn?.addEventListener('click', () => lightbox?.classList.add('hidden'));
    prevBtn?.addEventListener('click', () => showLightbox(currentIndex - 1));
    nextBtn?.addEventListener('click', () => showLightbox(currentIndex + 1));
    lightbox?.addEventListener('click', (e) => {
      if (e.target === lightbox) lightbox.classList.add('hidden');
    });
  })();
</script>
