---
import { HOME_EXPERIENCES } from '../../data';
---

<section id="hero" class="relative min-h-[92vh] lg:min-h-screen flex items-center justify-center overflow-hidden bg-neutral-950 pt-20">
  <!-- Slides Background Carousel -->
  <div class="absolute inset-0 z-0" id="hero-bg-container">
    {HOME_EXPERIENCES.map((exp, idx) => (
      <div
        class={`hero-bg-slide absolute inset-0 transition-opacity duration-1000 ease-in-out ${
          idx === 0 ? 'opacity-100 z-1' : 'opacity-0 z-0 pointer-events-none'
        }`}
        data-slide-index={idx}
      >
        <img
          src={exp.bgImage}
          alt={exp.title}
          class="w-full h-full object-cover object-center filter brightness-[0.65] contrast-[1.1] scale-100 transition-transform duration-10000"
          loading={idx === 0 ? "eager" : "lazy"}
          referrerpolicy="no-referrer"
        />
        <!-- Cinematic Gradient Overlay -->
        <div class="absolute inset-0 bg-gradient-to-t from-neutral-950 via-neutral-950/40 to-neutral-950/70" />
        <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_0%,rgba(0,0,0,0.6)_100%)]" />
      </div>
    ))}
  </div>

  <!-- Hero Content Center Container -->
  <div class="relative z-10 max-w-7xl mx-auto px-6 md:px-12 py-16 w-full flex flex-col justify-between min-h-[75vh]">
    
    <!-- Top Spacer / Subtitle -->
    <div class="max-w-3xl space-y-4 pt-6 text-left">
      {HOME_EXPERIENCES.map((exp, idx) => (
        <div
          class={`hero-text-slide space-y-5 transition-all duration-700 ${
            idx === 0 ? 'block opacity-100 translate-y-0' : 'hidden opacity-0 translate-y-6'
          }`}
          data-text-index={idx}
        >
          <!-- Badge -->
          <div class="inline-flex items-center space-x-2 bg-neutral-950/80 backdrop-blur-md border border-gold-400/30 px-3.5 py-1.5 rounded-full">
            <span class="w-2 h-2 rounded-full bg-gold-400 animate-pulse" />
            <span class="font-mono text-[9px] uppercase tracking-[0.25em] text-gold-300 font-bold">
              {exp.tourType || 'PREMIUM BALI EXPEDITION'}
            </span>
          </div>

          <!-- Main Title -->
          <h1 class="font-serif text-4xl sm:text-5xl md:text-6xl lg:text-7xl text-gold-100 font-normal tracking-tight leading-[1.08] text-balance">
            {exp.title}
          </h1>

          <!-- Tagline & Highlights -->
          <p class="font-sans text-base sm:text-lg md:text-xl text-gold-200/80 max-w-2xl font-light leading-relaxed">
            {exp.longDesc.slice(0, 160)}...
          </p>

          <!-- Metrics Row -->
          <div class="flex flex-wrap items-center gap-6 pt-2 text-xs md:text-sm font-mono text-gold-200/70">
            <div class="flex items-center space-x-2">
              <span class="text-gold-400">⏱</span>
              <span>{exp.duration}</span>
            </div>
            <div class="w-1 h-1 rounded-full bg-gold-400/40" />
            <div class="flex items-center space-x-2">
              <span class="text-gold-400">📍</span>
              <span>{exp.location}</span>
            </div>
            <div class="w-1 h-1 rounded-full bg-gold-400/40" />
            <div class="flex items-center space-x-2">
              <span class="text-gold-400">★</span>
              <span>{exp.rating} ({exp.reviewCount} Reviews)</span>
            </div>
          </div>

          <!-- CTA Buttons -->
          <div class="flex flex-wrap items-center gap-4 pt-4">
            <button
              type="button"
              data-book-trigger="true"
              data-book-id={exp.id}
              class="bg-gold-400 hover:bg-gold-500 text-neutral-950 font-mono text-xs uppercase tracking-[0.2em] font-bold px-8 py-4 transition-all duration-300 shadow-xl shadow-gold-500/10 cursor-pointer rounded-sm active:scale-95"
            >
              Book Now
            </button>
            <a
              href={`/tours`}
              class="border border-gold-400/30 hover:border-gold-400 text-gold-200 hover:text-gold-100 font-mono text-xs uppercase tracking-[0.2em] px-7 py-4 transition-all duration-300 rounded-sm cursor-pointer"
            >
              Lihat Semua Paket
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- Bottom Thumbnail Navigation Carousel -->
    <div class="pt-10 flex flex-col md:flex-row items-start md:items-end justify-between gap-6">
      
      <!-- Slide Thumbnails -->
      <div class="flex items-center space-x-3 overflow-x-auto pb-2 max-w-full" id="hero-thumb-controls">
        {HOME_EXPERIENCES.map((exp, idx) => (
          <button
            type="button"
            class={`hero-thumb-btn flex items-center space-x-3 p-2 rounded-md border transition-all text-left cursor-pointer group ${
              idx === 0
                ? 'bg-neutral-900/90 border-gold-400 shadow-lg'
                : 'bg-neutral-950/60 border-gold-900/20 hover:border-gold-400/40 opacity-70 hover:opacity-100'
            }`}
            data-index={idx}
          >
            <img
              src={exp.cardImage}
              alt={exp.title}
              class="w-12 h-12 object-cover rounded-sm border border-gold-400/30"
              loading="lazy"
              referrerpolicy="no-referrer"
            />
            <div class="pr-2 hidden sm:block">
              <span class="font-mono text-[9px] uppercase tracking-wider text-gold-400 font-bold block">
                0{idx + 1} / 0{HOME_EXPERIENCES.length}
              </span>
              <span class="font-serif text-xs text-gold-100 font-medium block truncate max-w-[130px]">
                {exp.title}
              </span>
            </div>
          </button>
        ))}
      </div>

      <!-- Arrow Controls & Pause -->
      <div class="flex items-center space-x-2 self-end">
        <button
          type="button"
          id="hero-prev-btn"
          aria-label="Previous Slide"
          class="w-10 h-10 rounded-full border border-gold-400/30 flex items-center justify-center text-gold-300 hover:text-gold-100 hover:border-gold-400 transition-colors cursor-pointer"
        >
          ‹
        </button>
        <button
          type="button"
          id="hero-next-btn"
          aria-label="Next Slide"
          class="w-10 h-10 rounded-full border border-gold-400/30 flex items-center justify-center text-gold-300 hover:text-gold-100 hover:border-gold-400 transition-colors cursor-pointer"
        >
          ›
        </button>
      </div>

    </div>

  </div>
</section>

<script is:inline>
  (function () {
    let currentIdx = 0;
    const totalSlides = 3;
    let timer = null;

    const bgSlides = document.querySelectorAll('.hero-bg-slide');
    const textSlides = document.querySelectorAll('.hero-text-slide');
    const thumbBtns = document.querySelectorAll('.hero-thumb-btn');
    const prevBtn = document.getElementById('hero-prev-btn');
    const nextBtn = document.getElementById('hero-next-btn');
    const heroSection = document.getElementById('hero');

    function showSlide(index) {
      currentIdx = (index + totalSlides) % totalSlides;

      // Update background slides
      bgSlides.forEach((slide, i) => {
        if (i === currentIdx) {
          slide.classList.remove('opacity-0', 'pointer-events-none');
          slide.classList.add('opacity-100');
        } else {
          slide.classList.remove('opacity-100');
          slide.classList.add('opacity-0', 'pointer-events-none');
        }
      });

      // Update text slides
      textSlides.forEach((text, i) => {
        if (i === currentIdx) {
          text.classList.remove('hidden', 'opacity-0', 'translate-y-6');
          text.classList.add('block', 'opacity-100', 'translate-y-0');
        } else {
          text.classList.add('hidden', 'opacity-0', 'translate-y-6');
          text.classList.remove('block', 'opacity-100', 'translate-y-0');
        }
      });

      // Update thumb active state
      thumbBtns.forEach((btn, i) => {
        if (i === currentIdx) {
          btn.classList.add('bg-neutral-900/90', 'border-gold-400', 'shadow-lg');
          btn.classList.remove('bg-neutral-950/60', 'border-gold-900/20', 'opacity-70');
        } else {
          btn.classList.remove('bg-neutral-900/90', 'border-gold-400', 'shadow-lg');
          btn.classList.add('bg-neutral-950/60', 'border-gold-900/20', 'opacity-70');
        }
      });
    }

    function startAutoPlay() {
      stopAutoPlay();
      timer = setInterval(() => {
        showSlide(currentIdx + 1);
      }, 5000);
    }

    function stopAutoPlay() {
      if (timer) clearInterval(timer);
    }

    // Attach click events to thumbs
    thumbBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const idx = parseInt(btn.getAttribute('data-index') || '0', 10);
        showSlide(idx);
        startAutoPlay();
      });
    });

    prevBtn?.addEventListener('click', () => {
      showSlide(currentIdx - 1);
      startAutoPlay();
    });

    nextBtn?.addEventListener('click', () => {
      showSlide(currentIdx + 1);
      startAutoPlay();
    });

    heroSection?.addEventListener('mouseenter', stopAutoPlay);
    heroSection?.addEventListener('mouseleave', startAutoPlay);

    startAutoPlay();
  })();
</script>
