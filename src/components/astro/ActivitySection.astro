---
const OUTDOOR_ACTIVITIES = [
  {
    id: 'atv-quad',
    title: 'Bali ATV Quad Bike Adventure',
    tagline: 'HIGH ADRENALINE',
    rating: 4.9,
    pricePerPerson: 45,
    duration: '2 Hours',
    location: 'Ubud, Gianyar',
    badge: 'Terpopuler',
    cardImage: '/activity_atv_jungle_1783677762979.jpg',
    shortDesc: 'Pacu adrenalin menembus trek hutan basah, goa air terjun, dan kubangan lumpur alami di Ubud.',
    highlights: ['All-Terrain Quad 250cc', 'Pemandu Lisensi & Asuransi Penuh', 'Makan Siang Prasmanan Termasuk'],
  },
  {
    id: 'river-tubing',
    title: 'Ayung River Rafting & Tubing',
    tagline: 'WILD RIVER',
    rating: 4.8,
    pricePerPerson: 35,
    duration: '3 Hours',
    location: 'Payangan, Ubud',
    badge: 'Rekomendasi',
    cardImage: '/activity_river_tubing_1783677780719.jpg',
    shortDesc: 'Menyusuri jeram Sungai Ayung sepanjang 10 km dengan pemandangan tebing relief Ramayana dan air terjun.',
    highlights: ['Peralatan Standard Internasional', 'Instruktur Profesional', 'Shower & Handuk Bersih'],
  },
  {
    id: 'bali-jungle-swing',
    title: 'Bali Jungle Swing & Plantation',
    tagline: 'INSTAGRAMMABLE',
    rating: 4.9,
    pricePerPerson: 25,
    duration: '2 Hours',
    location: 'Tegalalang, Ubud',
    badge: 'Instagrammable',
    cardImage: 'https://res.cloudinary.com/di6ziqvtp/image/upload/v1787397434/c67903ef-d494-4a2d-8614-e2e2964fc934.png',
    shortDesc: 'Sensasi melayang di atas lembah hijau dan terasering sawah dengan spot foto ikonik sarang burung.',
    highlights: ['Multiple Swing Heights', 'Tasting Kopi Luwak Gratis', 'Spot Foto Sarang Burung'],
  },
  {
    id: 'snorkeling',
    title: 'Blue Lagoon & Reef Snorkeling',
    tagline: 'OCEAN LIFE',
    rating: 4.8,
    pricePerPerson: 38,
    duration: '4 Hours',
    location: 'Padangbai, Karangasem',
    badge: 'Terlaris',
    cardImage: 'https://res.cloudinary.com/di6ziqvtp/image/upload/v1788783724/08865608-6a19-42db-aee3-2a8ec628dd1a.png',
    shortDesc: 'Berenang bersama ikan nemo dan terumbu karang warna-warni di perairan jernih Blue Lagoon & Tanjung Jepun.',
    highlights: ['Perahu Tradisional Jukung', 'Full Snorkel Gear & Fin', 'Pakan Ikan & Dokumentasi'],
  },
];
---

<section id="luxury-activities" class="py-24 bg-neutral-900/40 border-b border-gold-500/10 relative overflow-hidden">
  <div class="absolute top-1/2 left-1/4 -translate-y-1/2 w-[400px] h-[400px] bg-gold-500/5 rounded-full blur-[130px] pointer-events-none"></div>
  <div class="absolute top-1/3 right-1/4 -translate-y-1/2 w-[350px] h-[350px] bg-gold-400/5 rounded-full blur-[110px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-6 md:px-12 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center space-x-2 bg-gold-400/10 border border-gold-400/20 px-4 py-1.5 rounded-full mb-4">
        <span class="w-2 h-2 rounded-full bg-gold-400 animate-pulse"></span>
        <span class="font-mono text-[9px] uppercase tracking-[0.25em] text-gold-300 font-bold">
          High Adrenaline & Wilderness
        </span>
      </div>
      <h2 class="font-serif text-3xl md:text-5xl text-gold-200 tracking-wide font-medium">
        Petualangan Aktivitas Outdoor Elit
      </h2>
      <p class="font-sans text-xs md:text-sm text-gold-100/60 leading-relaxed mt-4 max-w-2xl mx-auto">
        Pacu adrenalin Anda dengan menembus rimbunnya hutan belantara Bali atau nikmati kesegaran alami menyusuri jeram sungai purba dengan standar keamanan internasional yang mewah.
      </p>
    </div>

    <!-- Cards Layout -->
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6">
      {OUTDOOR_ACTIVITIES.map((activity) => (
        <div class="bg-neutral-950/60 border border-gold-900/15 hover:border-gold-400/40 rounded-xl overflow-hidden flex flex-col group transition-all duration-500 hover:-translate-y-1.5 hover:shadow-2xl hover:shadow-gold-500/5">
          <!-- Image Section -->
          <div class="relative h-52 overflow-hidden bg-neutral-900">
            <img
              src={activity.cardImage}
              alt={activity.title}
              loading="lazy"
              referrerpolicy="no-referrer"
              class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105"
            />
            
            <div class="absolute inset-0 bg-gradient-to-t from-neutral-950 via-neutral-950/25 to-transparent"></div>
            
            <div class="absolute top-3 left-3 right-3 flex items-center justify-between z-10">
              <span class="bg-neutral-950/95 backdrop-blur-md border border-gold-400/25 text-gold-300 font-mono text-[8px] uppercase tracking-wider font-bold py-1 px-2.5 rounded-sm shadow-lg">
                {activity.tagline}
              </span>
              <div class="flex items-center space-x-1 bg-neutral-950/90 backdrop-blur-md border border-gold-900/30 px-2 py-1 rounded-sm shadow-md text-gold-400">
                <span class="text-xs">★</span>
                <span class="font-mono text-[10px] font-bold">{activity.rating}</span>
              </div>
            </div>

            <div class="absolute bottom-3 left-3 right-3 flex items-center justify-between text-[11px] font-mono text-gold-200/70">
              <span>⏱ {activity.duration}</span>
              <span>📍 {activity.location}</span>
            </div>
          </div>

          <!-- Body Section -->
          <div class="p-5 flex-grow flex flex-col justify-between text-left space-y-4">
            <div>
              <h3 class="font-serif text-lg text-gold-100 font-semibold leading-tight group-hover:text-gold-300 transition-colors">
                {activity.title}
              </h3>
              <p class="text-xs text-gold-200/60 mt-2 line-clamp-2 font-sans font-light">
                {activity.shortDesc}
              </p>

              <!-- Inclusions -->
              <ul class="mt-3 space-y-1 text-[11px] text-gold-200/70 font-sans">
                {activity.highlights.map((h) => (
                  <li class="flex items-center gap-1.5">
                    <span class="text-emerald-400 text-xs">✓</span>
                    <span>{h}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Price and Action -->
            <div class="pt-4 border-t border-gold-900/15 flex items-center justify-between">
              <div>
                <span class="font-mono text-[9px] uppercase tracking-wider text-gold-400/60 block">Mulai dari</span>
                <span class="font-mono text-lg font-bold text-gold-400">${activity.pricePerPerson} <span class="text-[10px] font-normal text-gold-200/50">/pax</span></span>
              </div>

              <a
                href={`https://wa.me/6281239633946?text=${encodeURIComponent(`Halo Tim Gede Bali Trip, saya ingin booking aktivitas *${activity.title}* ($${activity.pricePerPerson}/pax). Mohon info ketersediaan slotnya. Terima kasih!`)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="bg-gold-400 hover:bg-gold-500 text-neutral-950 font-mono text-[10px] uppercase tracking-wider font-bold px-4 py-2.5 rounded-sm transition-all shadow-md cursor-pointer active:scale-95 inline-flex items-center gap-1"
              >
                <span>Pesan</span>
                <span>→</span>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
