---
import { EXPERIENCES } from '../../data';
---

<div class="pt-28 pb-24 bg-neutral-950 text-gold-100 font-sans min-h-screen">
  <div class="max-w-7xl mx-auto px-6 md:px-12">
    
    <!-- Header Title -->
    <div class="max-w-3xl space-y-4 mb-16 text-left">
      <span class="font-mono text-xs uppercase tracking-[0.25em] text-gold-400 font-bold bg-gold-500/5 px-4 py-2 border border-gold-400/10 rounded-full inline-block">
        Bespoke Relations
      </span>
      <h1 class="font-serif text-4xl md:text-6xl text-gold-100 font-medium tracking-tight leading-tight">
        Hubungi Konsultan VIP Kami
      </h1>
      <p class="font-sans text-sm md:text-base text-gold-200/60 leading-relaxed font-light">
        Butuh informasi rute khusus, penjemputan bandara, atau rencana liburan keluarga terarah? Pramutamu eksklusif kami siap menyambut pertanyaan Anda 24/7.
      </p>
    </div>

    <!-- Form and Info Split -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start mb-24" id="contact-split-grid">
      
      <!-- Left Column: Direct Contact Info -->
      <div class="lg:col-span-5 space-y-8 text-left">
        <div class="bg-neutral-900/40 border border-gold-400/10 p-8 rounded-lg space-y-6">
          <h2 class="font-serif text-2xl text-gold-200 font-medium border-b border-gold-900/10 pb-4">
            Informasi Kantor Pusat
          </h2>
          
          <div class="space-y-6">
            <div class="flex items-start space-x-4">
              <span class="text-gold-400 text-lg mt-0.5">📍</span>
              <div>
                <h3 class="font-mono text-xs uppercase tracking-widest text-gold-300 font-bold">Seminyak HQ Location</h3>
                <p class="text-gold-200/60 text-xs md:text-sm leading-relaxed mt-1">
                  Jl. Raya Seminyak No. 108X, Seminyak, Kuta, Kabupaten Badung, Bali 80361, Indonesia
                </p>
              </div>
            </div>

            <div class="flex items-start space-x-4">
              <span class="text-gold-400 text-lg mt-0.5">📞</span>
              <div>
                <h3 class="font-mono text-xs uppercase tracking-widest text-gold-300 font-bold">WhatsApp Hotline & Concierge</h3>
                <p class="text-gold-200/60 text-xs md:text-sm leading-relaxed mt-1">
                  +62 812-3963-3946 (Tersedia 24/7)
                </p>
              </div>
            </div>

            <div class="flex items-start space-x-4">
              <span class="text-gold-400 text-lg mt-0.5">✉️</span>
              <div>
                <h3 class="font-mono text-xs uppercase tracking-widest text-gold-300 font-bold">VIP Email Desk</h3>
                <p class="text-gold-200/60 text-xs md:text-sm leading-relaxed mt-1">
                  concierge@gedebalitrip.com
                </p>
              </div>
            </div>
          </div>

          <!-- Direct WhatsApp Button -->
          <div class="pt-4 border-t border-gold-900/15">
            <a
              href="https://wa.me/6281239633946?text=Halo%20Gede%20Bali%20Trip,%20saya%20ingin%20konsultasi%20paket%20tour%20Bali."
              target="_blank"
              rel="noopener noreferrer"
              class="w-full bg-emerald-500 hover:bg-emerald-600 text-neutral-950 font-mono text-xs uppercase tracking-widest font-bold py-3.5 rounded-sm transition-all shadow-md flex items-center justify-center gap-2"
            >
              <span>Chat WhatsApp Langsung</span>
              <span>→</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive Form -->
      <div class="lg:col-span-7 bg-neutral-900/40 border border-gold-400/15 p-8 rounded-lg text-left">
        <h2 class="font-serif text-2xl text-gold-200 font-medium mb-6">
          Kirim Pesan Konsultasi
        </h2>

        <form id="contact-inquiry-form" class="space-y-5">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs uppercase font-mono text-gold-300/70 mb-1.5">Nama Lengkap</label>
              <input
                type="text"
                required
                id="contact-name"
                placeholder="Nama Anda"
                class="w-full bg-neutral-950 border border-gold-400/20 px-4 py-3 text-sm text-gold-100 rounded-sm focus:outline-none focus:border-gold-400 placeholder-gold-200/20"
              />
            </div>
            <div>
              <label class="block text-xs uppercase font-mono text-gold-300/70 mb-1.5">Alamat Email</label>
              <input
                type="email"
                required
                id="contact-email"
                placeholder="nama@email.com"
                class="w-full bg-neutral-950 border border-gold-400/20 px-4 py-3 text-sm text-gold-100 rounded-sm focus:outline-none focus:border-gold-400 placeholder-gold-200/20"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs uppercase font-mono text-gold-300/70 mb-1.5">No. WhatsApp</label>
              <input
                type="tel"
                required
                id="contact-phone"
                placeholder="+62 812..."
                class="w-full bg-neutral-950 border border-gold-400/20 px-4 py-3 text-sm text-gold-100 rounded-sm focus:outline-none focus:border-gold-400 placeholder-gold-200/20"
              />
            </div>
            <div>
              <label class="block text-xs uppercase font-mono text-gold-300/70 mb-1.5">Pilihan Minat Paket</label>
              <select
                id="contact-tour"
                class="w-full bg-neutral-950 border border-gold-400/20 px-4 py-3 text-sm text-gold-100 rounded-sm focus:outline-none focus:border-gold-400 cursor-pointer"
              >
                <option value="Umum / Custom Tour">Konsultasi Umum / Custom Tour</option>
                {EXPERIENCES.map((exp) => (
                  <option value={exp.title}>{exp.title}</option>
                ))}
              </select>
            </div>
          </div>

          <div>
            <label class="block text-xs uppercase font-mono text-gold-300/70 mb-1.5">Pesan atau Permintaan Khusus</label>
            <textarea
              required
              rows="4"
              id="contact-message"
              placeholder="Ceritakan rencana liburan, tanggal yang diinginkan, atau pertanyaan Anda..."
              class="w-full bg-neutral-950 border border-gold-400/20 px-4 py-3 text-sm text-gold-100 rounded-sm focus:outline-none focus:border-gold-400 placeholder-gold-200/20"
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full bg-gold-400 hover:bg-gold-500 text-neutral-950 font-mono text-xs uppercase tracking-widest font-bold py-4 rounded-sm transition-all shadow-md cursor-pointer active:scale-95"
          >
            Kirimkan Pertanyaan via WhatsApp
          </button>
        </form>
      </div>

    </div>

  </div>
</div>

<script is:inline>
  (function () {
    const form = document.getElementById('contact-inquiry-form');
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = document.getElementById('contact-name')?.value || '';
      const email = document.getElementById('contact-email')?.value || '';
      const phone = document.getElementById('contact-phone')?.value || '';
      const tour = document.getElementById('contact-tour')?.value || '';
      const msg = document.getElementById('contact-message')?.value || '';

      const text = `*KONSULTASI PERJALANAN - GEDE BALI TRIP*
---------------------------------------
• Nama: ${name}
• Email: ${email}
• WhatsApp: ${phone}
• Minat Paket: ${tour}

*PESAN:*
${msg}

Halo Tim Gede Bali Trip, mohon informasi lebih lanjut terkait pertanyaan saya. Terima kasih!`;

      window.open(`https://wa.me/6281239633946?text=${encodeURIComponent(text)}`, '_blank');
      form.reset();
    });
  })();
</script>
