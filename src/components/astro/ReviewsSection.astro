---
import { INITIAL_REVIEWS } from '../../data';
---

<section id="reviews" class="py-24 bg-neutral-900 border-t border-gold-900/10">
  <div class="max-w-7xl mx-auto px-6 md:px-12">
    
    <!-- Review Headers -->
    <div class="text-center max-w-2xl mx-auto space-y-4 mb-16">
      <p class="font-mono text-xs uppercase tracking-[0.3em] text-gold-400 font-semibold">
        Guest Testimonials
      </p>
      <h2 class="font-serif text-3xl md:text-4xl lg:text-5xl text-gold-100 font-medium tracking-wide">
        Shared Chronicles of Splendor
      </h2>
      <p class="font-sans text-sm md:text-base text-gold-100/50 leading-relaxed font-light">
        Ulasan langsung dari para wisatawan mancanegara dan domestik yang telah merasakan kenyamanan perjalanan privat bersama Gede Bali Trip.
      </p>
    </div>

    <!-- Aggregate Score Card & Actions -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-12 items-center">
      <div class="lg:col-span-5 bg-neutral-950/70 border border-gold-400/15 p-6 rounded-lg flex items-center justify-between gap-6">
        <div>
          <span class="font-mono text-[9px] uppercase tracking-widest text-gold-300/50 block">
            Skor Kepuasan Wisatawan
          </span>
          <div class="flex items-baseline space-x-2 mt-1">
            <span class="font-serif text-4xl md:text-5xl font-bold text-gold-400">4.9</span>
            <span class="text-gold-100/40 text-base">/ 5.0</span>
          </div>
          <div class="flex items-center space-x-1 text-gold-400 text-sm mt-1">
            <span>★★★★★</span>
            <span class="text-xs text-gold-200/50 ml-2 font-mono">(980+ Ulasan Terverifikasi)</span>
          </div>
        </div>

        <button
          type="button"
          id="btn-open-review-form"
          class="bg-gold-400/10 hover:bg-gold-400 hover:text-neutral-950 text-gold-400 border border-gold-400/30 text-xs font-mono uppercase tracking-wider font-bold px-4 py-3 rounded-sm transition-all cursor-pointer"
        >
          Tulis Ulasan
        </button>
      </div>

      <!-- Rating Filters -->
      <div class="lg:col-span-7 flex flex-wrap gap-2 justify-start lg:justify-end">
        <button
          type="button"
          class="review-filter-btn px-4 py-2 rounded-sm text-xs font-mono font-semibold uppercase tracking-wider transition-all bg-gold-400 text-neutral-950 font-bold border border-gold-400 cursor-pointer"
          data-rating="all"
        >
          Semua Ulasan
        </button>
        <button
          type="button"
          class="review-filter-btn px-4 py-2 rounded-sm text-xs font-mono font-semibold uppercase tracking-wider transition-all border border-gold-900/30 text-gold-200/60 hover:text-gold-200 hover:border-gold-400/40 cursor-pointer"
          data-rating="5"
        >
          ★ 5 Bintang
        </button>
      </div>
    </div>

    <!-- Review Submission Form (Toggled via JS) -->
    <div id="review-submission-box" class="hidden mb-12 bg-neutral-950 border border-gold-400/30 p-6 md:p-8 rounded-lg animate-fade-in text-left">
      <div class="flex justify-between items-center mb-6">
        <h3 class="font-serif text-xl text-gold-200">Bagikan Pengalaman Liburan Anda</h3>
        <button type="button" id="btn-close-review-form" class="text-gold-300/60 hover:text-gold-400">✕</button>
      </div>
      <form id="form-new-review" class="space-y-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <input
            type="text"
            id="rev-input-name"
            required
            placeholder="Nama Lengkap Anda"
            class="w-full bg-neutral-900 border border-gold-400/20 px-4 py-3 text-sm text-gold-100 rounded-sm focus:outline-none focus:border-gold-400"
          />
          <select
            id="rev-input-rating"
            class="w-full bg-neutral-900 border border-gold-400/20 px-4 py-3 text-sm text-gold-100 rounded-sm focus:outline-none focus:border-gold-400"
          >
            <option value="5">★★★★★ (5 Bintang - Sempurna)</option>
            <option value="4">★★★★☆ (4 Bintang - Sangat Bagus)</option>
          </select>
        </div>
        <textarea
          id="rev-input-comment"
          required
          rows="3"
          placeholder="Ceritakan pengalaman Anda bersama supir dan tur Gede Bali Trip..."
          class="w-full bg-neutral-900 border border-gold-400/20 px-4 py-3 text-sm text-gold-100 rounded-sm focus:outline-none focus:border-gold-400"
        ></textarea>
        <button
          type="submit"
          class="bg-gold-400 hover:bg-gold-500 text-neutral-950 font-mono text-xs uppercase tracking-widest font-bold px-6 py-3 rounded-sm transition-all cursor-pointer"
        >
          Kirim Ulasan Anda
        </button>
      </form>
    </div>

    <!-- Reviews Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 text-left" id="reviews-container">
      {INITIAL_REVIEWS.map((review) => (
        <div
          class="review-card bg-neutral-950/60 border border-gold-900/15 p-6 rounded-lg flex flex-col justify-between group hover:border-gold-400/30 transition-all duration-300"
          data-rating={review.rating}
        >
          <div class="space-y-4">
            <!-- Stars & Verified -->
            <div class="flex items-center justify-between">
              <div class="flex items-center text-gold-400 text-sm">
                {'★'.repeat(review.rating)}
              </div>
              <span class="inline-flex items-center gap-1 font-mono text-[9px] uppercase tracking-widest text-emerald-400">
                <span>✓</span>
                <span>Verified</span>
              </span>
            </div>

            <!-- Comment -->
            <p class="font-sans text-xs md:text-sm text-gold-100/75 leading-relaxed font-light italic">
              "{review.comment}"
            </p>
          </div>

          <!-- Author Info -->
          <div class="pt-4 mt-6 border-t border-gold-900/10 flex items-center justify-between">
            <div>
              <h4 class="font-serif text-sm text-gold-200 font-medium">{review.name}</h4>
              <p class="font-mono text-[10px] text-gold-200/40">{review.date}</p>
            </div>
            <div class="w-7 h-7 rounded-full bg-gold-400/10 border border-gold-400/20 flex items-center justify-center text-gold-400 font-mono text-xs font-bold">
              {review.name.charAt(0)}
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<script is:inline>
  (function () {
    const filterBtns = document.querySelectorAll('.review-filter-btn');
    const reviewCards = document.querySelectorAll('.review-card');
    const formBox = document.getElementById('review-submission-box');
    const openBtn = document.getElementById('btn-open-review-form');
    const closeBtn = document.getElementById('btn-close-review-form');
    const form = document.getElementById('form-new-review');
    const container = document.getElementById('reviews-container');

    // Filter cards
    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const rating = btn.getAttribute('data-rating');
        filterBtns.forEach((b) => {
          b.classList.remove('bg-gold-400', 'text-neutral-950', 'font-bold', 'border-gold-400');
          b.classList.add('border-gold-900/30', 'text-gold-200/60');
        });
        btn.classList.add('bg-gold-400', 'text-neutral-950', 'font-bold', 'border-gold-400');
        btn.classList.remove('border-gold-900/30', 'text-gold-200/60');

        reviewCards.forEach((card) => {
          if (rating === 'all' || card.getAttribute('data-rating') === rating) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });
      });
    });

    openBtn?.addEventListener('click', () => {
      formBox?.classList.remove('hidden');
    });

    closeBtn?.addEventListener('click', () => {
      formBox?.classList.add('hidden');
    });

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = document.getElementById('rev-input-name')?.value || 'Guest';
      const rating = parseInt(document.getElementById('rev-input-rating')?.value || '5', 10);
      const comment = document.getElementById('rev-input-comment')?.value || '';

      const newCard = document.createElement('div');
      newCard.className = 'review-card bg-neutral-950/60 border border-gold-400/40 p-6 rounded-lg flex flex-col justify-between group animate-fade-in';
      newCard.setAttribute('data-rating', rating.toString());
      newCard.innerHTML = `
        <div class="space-y-4">
          <div class="flex items-center justify-between">
            <div class="flex items-center text-gold-400 text-sm">${'★'.repeat(rating)}</div>
            <span class="inline-flex items-center gap-1 font-mono text-[9px] uppercase tracking-widest text-emerald-400">
              <span>✓</span><span>Baru Ditambahkan</span>
            </span>
          </div>
          <p class="font-sans text-xs md:text-sm text-gold-100/75 leading-relaxed font-light italic">"${comment}"</p>
        </div>
        <div class="pt-4 mt-6 border-t border-gold-900/10 flex items-center justify-between">
          <div>
            <h4 class="font-serif text-sm text-gold-200 font-medium">${name}</h4>
            <p class="font-mono text-[10px] text-gold-200/40">Hari ini</p>
          </div>
          <div class="w-7 h-7 rounded-full bg-gold-400/10 border border-gold-400/20 flex items-center justify-center text-gold-400 font-mono text-xs font-bold">${name.charAt(0)}</div>
        </div>
      `;

      container?.prepend(newCard);
      form.reset();
      formBox?.classList.add('hidden');
    });
  })();
</script>
