---
import { EXPERIENCES, BOOKING_ADDONS } from '../../data';
---

<div
  id="global-booking-modal"
  class="fixed inset-0 z-50 flex items-center justify-center p-4 overflow-y-auto bg-black/90 backdrop-blur-sm text-gold-100 font-sans hidden"
  role="dialog"
  aria-modal="true"
  aria-labelledby="booking-modal-title"
>
  <div
    id="booking-modal-container"
    class="relative bg-neutral-950 border border-gold-400/25 w-full max-w-5xl rounded-lg shadow-2xl overflow-hidden flex flex-col my-8 max-h-[92vh]"
  >
    <!-- Header bar -->
    <div class="flex items-center justify-between px-6 py-4 bg-neutral-900 border-b border-gold-900/10">
      <div class="flex items-center space-x-3">
        <img
          src="https://res.cloudinary.com/di6ziqvtp/image/upload/v1788783630/2dff2e80-f5bc-4bd7-8c97-2c99e0d9db5f.png"
          alt="Gede Bali Trip"
          class="h-8 w-auto object-contain"
          referrerpolicy="no-referrer"
        />
        <h2 id="booking-modal-title" class="font-serif text-lg text-gold-200 tracking-wide font-medium">
          Reservasi Paket Tour & Transport VIP
        </h2>
      </div>
      <button
        type="button"
        id="btn-close-booking-modal"
        class="text-gold-300/60 hover:text-gold-400 transition-colors p-1 cursor-pointer"
        aria-label="Tutup Modal"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Form Content Box -->
    <div class="flex-grow overflow-y-auto p-6 md:p-8">
      
      <!-- STEP 1: BOOKING DETAILS FORM -->
      <form id="form-booking-modal" class="grid grid-cols-1 lg:grid-cols-12 gap-8 text-left">
        
        <!-- Left Column Form inputs -->
        <div class="lg:col-span-7 space-y-6">
          
          <!-- Select Package Dropdown -->
          <div class="space-y-1.5">
            <label class="block text-xs uppercase tracking-widest text-gold-300/70 font-semibold font-mono">
              Pilih Paket Perjalanan Eksklusif
            </label>
            <select
              id="booking-select-experience"
              class="w-full bg-neutral-900 border border-gold-400/20 px-4 py-3 text-sm text-gold-100 rounded-sm focus:outline-none focus:border-gold-400 font-sans cursor-pointer"
            >
              {EXPERIENCES.map((exp) => (
                <option value={exp.id} data-price-person={exp.pricePerPerson} data-price-car={exp.pricePerCar || 0} data-title={exp.title} data-image={exp.cardImage} data-location={exp.location}>
                  {exp.title} — {exp.pricePerCar ? `$${exp.pricePerCar} / car` : `$${exp.pricePerPerson} per orang`}
                </option>
              ))}
            </select>
          </div>

          <!-- Date & Guest Selectors -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div class="space-y-1.5">
              <label class="block text-xs uppercase tracking-widest text-gold-300/70 font-semibold font-mono flex items-center gap-1.5">
                <span>📅</span>
                <span>Pilih Tanggal</span>
              </label>
              <input
                type="date"
                required
                id="booking-input-date"
                class="w-full bg-neutral-900 border border-gold-400/20 px-4 py-3 text-sm text-gold-100 rounded-sm focus:outline-none focus:border-gold-400 font-sans [color-scheme:dark] cursor-pointer"
              />
            </div>

            <div class="space-y-1.5">
              <label class="block text-xs uppercase tracking-widest text-gold-300/70 font-semibold font-mono flex items-center gap-1.5">
                <span>👥</span>
                <span>Jumlah Peserta</span>
              </label>
              <div class="flex items-center border border-gold-400/20 rounded-sm bg-neutral-900">
                <button
                  type="button"
                  id="btn-guests-minus"
                  class="px-4 py-3 text-gold-300 hover:text-gold-400 font-bold cursor-pointer"
                >
                  −
                </button>
                <span id="booking-guests-label" class="flex-grow text-center text-sm font-semibold text-gold-100 font-mono">
                  2 Orang
                </span>
                <button
                  type="button"
                  id="btn-guests-plus"
                  class="px-4 py-3 text-gold-300 hover:text-gold-400 font-bold cursor-pointer"
                >
                  +
                </button>
              </div>
            </div>
          </div>

          <!-- Date Warning Notice (Hidden by default) -->
          <div id="booking-date-warning" class="hidden bg-red-950/40 border border-red-500/30 p-4 rounded-md text-xs text-red-200 flex items-start gap-2.5">
            <span class="text-base">⚠️</span>
            <p id="booking-date-warning-text" class="leading-relaxed">
              Jadwal ini sedang terisi penuh. Silakan pilih tanggal lain.
            </p>
          </div>

          <!-- Primary Contact Details -->
          <div class="space-y-4 pt-4 border-t border-gold-900/10">
            <h3 class="text-xs uppercase tracking-widest text-gold-300 font-bold font-mono">
              Informasi Pemesan Utama
            </h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <input
                type="text"
                required
                id="booking-input-name"
                placeholder="Nama Pemesan Utama"
                class="w-full bg-neutral-900 border border-gold-400/15 px-4 py-3 text-sm text-gold-100 rounded-sm focus:outline-none focus:border-gold-400 placeholder-gold-300/20"
              />
              <input
                type="email"
                required
                id="booking-input-email"
                placeholder="Alamat Email"
                class="w-full bg-neutral-900 border border-gold-400/15 px-4 py-3 text-sm text-gold-100 rounded-sm focus:outline-none focus:border-gold-400 placeholder-gold-300/20"
              />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <input
                type="tel"
                required
                id="booking-input-phone"
                placeholder="Nomor WhatsApp (aktif)"
                class="w-full bg-neutral-900 border border-gold-400/15 px-4 py-3 text-sm text-gold-100 rounded-sm focus:outline-none focus:border-gold-400 placeholder-gold-300/20"
              />
              <input
                type="text"
                id="booking-input-notes"
                placeholder="Catatan Khusus (Hotel jemput, alergi makanan, dll.)"
                class="w-full bg-neutral-900 border border-gold-400/15 px-4 py-3 text-sm text-gold-100 rounded-sm focus:outline-none focus:border-gold-400 placeholder-gold-300/20"
              />
            </div>
          </div>

          <!-- VIP Addons Checklist -->
          <div class="space-y-3">
            <h3 class="text-xs uppercase tracking-widest text-gold-300 font-bold font-mono">
              Peningkatan Layanan (VIP Upgrades)
            </h3>
            <div class="space-y-2.5">
              {BOOKING_ADDONS.map((addon) => (
                <label class="booking-addon-item flex items-start justify-between p-3.5 border border-gold-900/15 bg-neutral-900/20 hover:border-gold-400/30 rounded-sm transition-all cursor-pointer">
                  <div class="flex items-start space-x-3 pr-4">
                    <input
                      type="checkbox"
                      class="addon-checkbox mt-1 accent-gold-400"
                      value={addon.id}
                      data-price={addon.price}
                      data-name={addon.name}
                    />
                    <div>
                      <h4 class="font-serif text-sm text-gold-200 font-medium">
                        {addon.name}
                      </h4>
                      <p class="font-sans text-[11px] text-gold-100/50 leading-relaxed mt-0.5">
                        {addon.description}
                      </p>
                    </div>
                  </div>
                  <span class="font-mono text-sm font-semibold text-gold-400 flex-shrink-0">
                    +${addon.price}
                  </span>
                </label>
              ))}
            </div>
          </div>

        </div>

        <!-- Right Panel Summary Invoice -->
        <div class="lg:col-span-5 bg-neutral-900/60 border border-gold-400/15 p-6 rounded-md flex flex-col justify-between h-fit lg:sticky lg:top-4">
          <div>
            <h3 class="font-serif text-lg text-gold-200 border-b border-gold-900/10 pb-3 mb-4 font-medium tracking-wide">
              Rincian Pembayaran
            </h3>

            <div class="flex items-center space-x-3 mb-6 bg-neutral-900 p-3 border border-gold-900/10 rounded-sm">
              <img
                id="summary-preview-image"
                src={EXPERIENCES[0].cardImage}
                alt="Selected Tour"
                class="w-12 h-16 object-cover rounded-sm border border-gold-400/20 flex-shrink-0"
              />
              <div>
                <p class="font-mono text-[9px] uppercase tracking-wider text-gold-400">Private Experience</p>
                <h4 id="summary-preview-title" class="font-serif text-sm text-gold-100 font-medium leading-tight">
                  {EXPERIENCES[0].title}
                </h4>
                <p id="summary-preview-location" class="font-sans text-[11px] text-gold-200/40 mt-0.5">
                  {EXPERIENCES[0].location}
                </p>
              </div>
            </div>

            <div class="space-y-4 text-sm">
              <div class="flex justify-between items-center text-gold-100/60">
                <span id="summary-base-label">Tarif Dasar (2 Orang)</span>
                <span id="summary-base-price" class="font-mono text-gold-100">$240</span>
              </div>

              <div id="summary-addons-box" class="hidden space-y-2 pt-2 border-t border-gold-900/10">
                <span class="text-[10px] uppercase font-mono text-gold-400 tracking-wider block">Upgrade Tambahan</span>
                <div id="summary-addons-list" class="space-y-1 text-xs text-gold-100/50 pl-2"></div>
              </div>

              <div class="flex justify-between items-center text-gold-100/60 pt-4 border-t border-gold-900/10">
                <span>Subtotal</span>
                <span id="summary-subtotal" class="font-mono text-gold-100">$240</span>
              </div>

              <div class="flex justify-between items-center text-gold-100/60">
                <span class="flex items-center gap-1">
                  <span>Pajak Pariwisata & Layanan VIP</span>
                  <span class="bg-gold-500/10 text-gold-300 font-mono text-[9px] px-1.5 py-0.5 rounded">Termasuk</span>
                </span>
                <span class="font-mono text-gold-100">$0</span>
              </div>
            </div>
          </div>

          <div class="pt-6 mt-8 border-t border-gold-400/20">
            <div class="flex justify-between items-baseline mb-6">
              <span class="font-serif text-base text-gold-200">Total Pembayaran</span>
              <span id="summary-grand-total" class="font-mono text-2xl md:text-3xl text-gold-400 font-bold">$240</span>
            </div>

            <button
              type="submit"
              id="btn-submit-booking-wa"
              class="w-full bg-emerald-500 hover:bg-emerald-600 text-neutral-950 font-mono text-xs uppercase tracking-[0.2em] font-bold py-4 rounded-sm transition-all duration-300 flex items-center justify-center space-x-2 cursor-pointer active:scale-95 shadow-md shadow-emerald-500/10"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.669-.699c.969.54 1.771.82 2.791.82 3.181 0 5.767-2.586 5.768-5.766 0-3.18-2.587-5.766-5.768-5.766zm9.969 5.766c0 5.502-4.478 9.98-9.969 9.98-1.741 0-3.376-.452-4.802-1.242l-5.229 1.369 1.395-5.097c-.899-1.482-1.414-3.218-1.414-5.07 0-5.502 4.478-9.978 9.969-9.978 5.491 0 10.05 4.536 10.05 10.038z"/>
              </svg>
              <span>Lanjutkan ke WhatsApp</span>
            </button>

            <div class="flex items-center justify-center space-x-2 text-[9px] text-gold-300/40 font-mono mt-4">
              <span>🔒 SECURE DIRECT CONCIERGE DESK</span>
            </div>
          </div>
        </div>

      </form>

    </div>

  </div>
</div>

<script is:inline>
  (function () {
    const modal = document.getElementById('global-booking-modal');
    const closeBtn = document.getElementById('btn-close-booking-modal');
    const expSelect = document.getElementById('booking-select-experience');
    const dateInput = document.getElementById('booking-input-date');
    const minusBtn = document.getElementById('btn-guests-minus');
    const plusBtn = document.getElementById('btn-guests-plus');
    const guestsLabel = document.getElementById('booking-guests-label');
    const addonCheckboxes = document.querySelectorAll('.addon-checkbox');
    const form = document.getElementById('form-booking-modal');

    const previewImg = document.getElementById('summary-preview-image');
    const previewTitle = document.getElementById('summary-preview-title');
    const previewLoc = document.getElementById('summary-preview-location');
    const baseLabel = document.getElementById('summary-base-label');
    const basePriceEl = document.getElementById('summary-base-price');
    const addonsBox = document.getElementById('summary-addons-box');
    const addonsList = document.getElementById('summary-addons-list');
    const subtotalEl = document.getElementById('summary-subtotal');
    const grandTotalEl = document.getElementById('summary-grand-total');
    const dateWarning = document.getElementById('booking-date-warning');

    let guests = 2;

    // Set min date to today
    if (dateInput) {
      dateInput.min = new Date().toISOString().split('T')[0];
    }

    function calculateTotal() {
      const selectedOption = expSelect?.options[expSelect.selectedIndex];
      if (!selectedOption) return;

      const pricePerPerson = parseFloat(selectedOption.getAttribute('data-price-person') || '0');
      const pricePerCar = parseFloat(selectedOption.getAttribute('data-price-car') || '0');
      const title = selectedOption.getAttribute('data-title') || '';
      const image = selectedOption.getAttribute('data-image') || '';
      const loc = selectedOption.getAttribute('data-location') || '';

      if (previewImg) previewImg.src = image;
      if (previewTitle) previewTitle.textContent = title;
      if (previewLoc) previewLoc.textContent = loc;

      const basePrice = pricePerCar > 0 ? pricePerCar : pricePerPerson * guests;
      if (baseLabel) {
        baseLabel.textContent = pricePerCar > 0 ? 'Tarif Sewa Privat (1 Mobil)' : `Tarif Dasar (${guests} Orang)`;
      }
      if (basePriceEl) basePriceEl.textContent = `$${basePrice}`;

      // Calculate addons
      let addonsTotal = 0;
      let addonItemsHtml = '';
      addonCheckboxes.forEach((cb) => {
        if (cb.checked) {
          const price = parseFloat(cb.getAttribute('data-price') || '0');
          const name = cb.getAttribute('data-name') || '';
          addonsTotal += price;
          addonItemsHtml += `<div class="flex justify-between"><span>${name}</span><span class="font-mono text-gold-300">+$${price}</span></div>`;
        }
      });

      if (addonsBox && addonsList) {
        if (addonsTotal > 0) {
          addonsBox.classList.remove('hidden');
          addonsList.innerHTML = addonItemsHtml;
        } else {
          addonsBox.classList.add('hidden');
          addonsList.innerHTML = '';
        }
      }

      const total = basePrice + addonsTotal;
      if (subtotalEl) subtotalEl.textContent = `$${total}`;
      if (grandTotalEl) grandTotalEl.textContent = `$${total}`;

      return { total, basePrice, title };
    }

    // Modal Global Methods
    window.openBookingModal = function (expId) {
      if (!modal) return;
      modal.classList.remove('hidden');
      document.body.classList.add('overflow-hidden');
      if (expSelect && expId) {
        expSelect.value = expId;
      }
      calculateTotal();
    };

    window.closeBookingModal = function () {
      if (!modal) return;
      modal.classList.add('hidden');
      document.body.classList.remove('overflow-hidden');
    };

    closeBtn?.addEventListener('click', window.closeBookingModal);
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) window.closeBookingModal();
    });

    expSelect?.addEventListener('change', calculateTotal);
    addonCheckboxes.forEach((cb) => cb.addEventListener('change', calculateTotal));

    minusBtn?.addEventListener('click', () => {
      if (guests > 1) {
        guests--;
        if (guestsLabel) guestsLabel.textContent = `${guests} Orang`;
        calculateTotal();
      }
    });

    plusBtn?.addEventListener('click', () => {
      if (guests < 15) {
        guests++;
        if (guestsLabel) guestsLabel.textContent = `${guests} Orang`;
        calculateTotal();
      }
    });

    // Date validation check
    dateInput?.addEventListener('change', () => {
      const selected = new Date(dateInput.value);
      if (selected.getDay() === 1) {
        dateWarning?.classList.remove('hidden');
      } else {
        dateWarning?.classList.add('hidden');
      }
    });

    // Handle Form Submit -> WhatsApp
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const date = dateInput?.value || '';
      const name = document.getElementById('booking-input-name')?.value || '';
      const email = document.getElementById('booking-input-email')?.value || '';
      const phone = document.getElementById('booking-input-phone')?.value || '';
      const notes = document.getElementById('booking-input-notes')?.value || '';

      const selectedOption = expSelect?.options[expSelect.selectedIndex];
      const title = selectedOption?.getAttribute('data-title') || '';
      const { total } = calculateTotal() || { total: 0 };

      const addonsChosen = [];
      addonCheckboxes.forEach((cb) => {
        if (cb.checked) {
          addonsChosen.push(`• ${cb.getAttribute('data-name')} (+$${cb.getAttribute('data-price')})`);
        }
      });

      const message = `*RESERVASI TOUR - GEDE BALI TRIP*
---------------------------------------
*Paket Tour:* ${title}
*Tanggal Trip:* ${date}
*Jumlah Peserta:* ${guests} Orang

*DATA PEMESAN:*
• Nama: ${name}
• Email: ${email}
• WhatsApp: ${phone}

${addonsChosen.length > 0 ? `*LAYANAN TAMBAHAN:*\n${addonsChosen.join('\n')}\n\n` : ''}*CATATAN KHUSUS:*
${notes || '-'}

---------------------------------------
*ESTIMASI TOTAL:* $${total}
---------------------------------------

Halo Tim Gede Bali Trip, saya ingin mengonfirmasi ketersediaan paket tur di atas. Mohon info ketersediaannya. Terima kasih!`;

      const waUrl = `https://wa.me/6281239633946?text=${encodeURIComponent(message)}`;
      window.open(waUrl, '_blank');
      window.closeBookingModal();
    });

    calculateTotal();
  })();
</script>
