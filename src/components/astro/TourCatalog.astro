---
import { TOUR_PACKAGES } from '../../data';
---

<div class="pt-28 pb-24 px-4 sm:px-6 md:px-12 bg-neutral-950 min-h-screen text-gold-100 font-sans">
  <div class="max-w-7xl mx-auto">
    
    <!-- Banner Section -->
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-14">
      <div class="inline-flex items-center space-x-2 bg-gold-500/10 border border-gold-400/20 px-4 py-1.5 rounded-full">
        <span class="w-2 h-2 rounded-full bg-gold-400 animate-pulse"></span>
        <span class="font-mono text-xs uppercase tracking-[0.25em] text-gold-400 font-bold">
          Official Private Tour Packages
        </span>
      </div>
      <h1 class="font-serif text-3xl sm:text-4xl md:text-6xl text-gold-100 font-medium tracking-wide">
        Paket Tour Privat Bali
      </h1>
      <p class="font-sans text-sm md:text-base text-gold-200/70 leading-relaxed font-light max-w-2xl mx-auto">
        Nikmati keindahan autentik Bali dengan kendaraan ber-AC privat, supir berpengalaman berbahasa Inggris, dan jadwal perjalanan yang 100% fleksibel tanpa dicampur peserta lain.
      </p>
    </div>

    <!-- Filter Buttons -->
    <div class="flex justify-center mb-12">
      <div class="inline-flex p-1.5 bg-neutral-900 border border-gold-400/20 rounded-lg">
        <button
          type="button"
          class="tour-filter-btn px-5 py-2.5 rounded-md text-xs font-mono font-bold uppercase tracking-wider transition-all duration-300 bg-gold-400 text-neutral-950 cursor-pointer"
          data-tab="all"
        >
          Semua Paket (2)
        </button>
        <button
          type="button"
          class="tour-filter-btn px-5 py-2.5 rounded-md text-xs font-mono font-semibold uppercase tracking-wider transition-all duration-300 text-gold-300/60 hover:text-gold-200 cursor-pointer"
          data-tab="ubud-highlights"
        >
          Ubud Highlights
        </button>
        <button
          type="button"
          class="tour-filter-btn px-5 py-2.5 rounded-md text-xs font-mono font-semibold uppercase tracking-wider transition-all duration-300 text-gold-300/60 hover:text-gold-200 cursor-pointer"
          data-tab="uluwatu-sunset"
        >
          🌅 Uluwatu & Sunset
        </button>
      </div>
    </div>

    <!-- Tour Cards Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-stretch" id="tour-packages-deck">
      {TOUR_PACKAGES.map((exp) => (
        <div
          class="tour-card bg-neutral-900/60 border border-gold-400/20 rounded-2xl overflow-hidden flex flex-col justify-between shadow-2xl hover:border-gold-400/40 transition-all duration-500 text-left"
          data-id={exp.id}
        >
          <!-- Image with Tagline & Badges -->
          <div class="relative h-72 sm:h-80 w-full overflow-hidden group">
            <img
              src={exp.cardImage}
              alt={exp.title}
              loading="lazy"
              referrerpolicy="no-referrer"
              class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-neutral-950 via-neutral-950/30 to-transparent"></div>

            <div class="absolute top-4 left-4">
              <span class="inline-flex items-center gap-1.5 bg-neutral-950/80 backdrop-blur-md border border-gold-400/30 text-gold-300 text-xs font-mono font-semibold px-3 py-1.5 rounded-full">
                ✦ {exp.tagline}
              </span>
            </div>

            <div class="absolute top-4 right-4 bg-neutral-950/80 backdrop-blur-md border border-gold-400/30 rounded-full px-3 py-1.5 flex items-center gap-1.5 text-gold-400">
              <span class="text-xs">★</span>
              <span class="font-mono text-xs font-bold">{exp.rating}</span>
              <span class="text-[10px] text-gold-200/60 font-mono">({exp.reviewCount})</span>
            </div>

            <div class="absolute bottom-4 left-4 right-4 text-left">
              <div class="inline-block bg-gold-400 text-neutral-950 text-[10px] font-mono font-extrabold uppercase tracking-widest px-2.5 py-0.5 rounded-sm mb-1.5">
                {exp.tourType || 'PRIVATE TOUR'}
              </div>
              <h2 class="font-serif text-2xl sm:text-3xl font-medium text-gold-100 tracking-wide drop-shadow-md">
                {exp.title}
              </h2>
            </div>
          </div>

          <!-- Body details -->
          <div class="p-6 sm:p-8 flex-grow flex flex-col justify-between space-y-6">
            
            <p class="font-sans text-xs sm:text-sm text-gold-200/70 leading-relaxed font-light">
              {exp.shortDesc}
            </p>

            <!-- Metrics bar -->
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 p-3.5 bg-neutral-950/80 border border-gold-400/10 rounded-xl text-left text-xs font-mono">
              <div>
                <span class="text-gold-400/60 block text-[10px] uppercase">Durasi Tour</span>
                <span class="text-gold-200 font-semibold">{exp.duration}</span>
              </div>
              <div>
                <span class="text-gold-400/60 block text-[10px] uppercase">Tipe Mobil</span>
                <span class="text-gold-200 font-semibold">Toyota MPV AC</span>
              </div>
              <div class="col-span-2 sm:col-span-1">
                <span class="text-gold-400/60 block text-[10px] uppercase">Extra Hour</span>
                <span class="text-gold-200 font-semibold">{exp.extraHourRate || '$5/jam'}</span>
              </div>
            </div>

            <!-- Highlights Checklist -->
            <div class="space-y-3">
              <h3 class="font-mono text-xs uppercase tracking-wider text-gold-400 font-bold flex items-center gap-2">
                <span>📍 Destinasi & Spot Utama</span>
              </h3>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs text-gold-200/80">
                {exp.highlights.map((h) => (
                  <div class="flex items-center gap-2 bg-neutral-950/40 p-2 rounded-md border border-gold-900/10">
                    <span class="text-gold-400">✓</span>
                    <span class="truncate">{h}</span>
                  </div>
                ))}
              </div>
            </div>

            <!-- Inclusions & Exclusions -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4 border-t border-gold-900/15 text-xs">
              <div>
                <h4 class="font-mono text-[10px] uppercase text-emerald-400 font-bold mb-2">Sudah Termasuk:</h4>
                <ul class="space-y-1 text-gold-200/70">
                  {exp.inclusions.map((inc) => (
                    <li class="flex items-start gap-1.5">
                      <span class="text-emerald-400 text-xs mt-0.5">✓</span>
                      <span>{inc}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div>
                <h4 class="font-mono text-[10px] uppercase text-amber-400 font-bold mb-2">Belum Termasuk:</h4>
                <ul class="space-y-1 text-gold-200/60">
                  {exp.exclusions.map((exc) => (
                    <li class="flex items-start gap-1.5">
                      <span class="text-amber-400 text-xs mt-0.5">•</span>
                      <span>{exc}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <!-- Itinerary Timeline Preview -->
            <div class="space-y-3 pt-4 border-t border-gold-900/15">
              <h4 class="font-mono text-[10px] uppercase tracking-wider text-gold-400 font-bold">
                Jadwal Rute Perjalanan (Fleksibel):
              </h4>
              <div class="space-y-2 max-h-48 overflow-y-auto pr-2 text-xs">
                {exp.itinerary.map((item) => (
                  <div class="flex items-start gap-3 bg-neutral-950/50 p-2.5 rounded border border-gold-900/10">
                    <span class="font-mono text-gold-400 text-[10px] font-bold whitespace-nowrap bg-neutral-900 px-2 py-0.5 rounded">
                      {item.time}
                    </span>
                    <div>
                      <p class="font-serif text-gold-200 font-medium">{item.title}</p>
                      <p class="text-[11px] text-gold-200/50 mt-0.5">{item.desc}</p>
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <!-- Price & Booking CTA -->
            <div class="pt-6 border-t border-gold-400/20 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4">
              <div>
                <span class="font-mono text-[10px] uppercase text-gold-400/70 block">Harga Paket Privat</span>
                <div class="flex items-baseline gap-1">
                  <span class="font-mono text-3xl font-extrabold text-gold-400">${exp.pricePerCar || exp.pricePerPerson}</span>
                  <span class="text-xs text-gold-200/60 font-mono">/ mobil (Maks. 5-6 orang)</span>
                </div>
              </div>

              <div class="flex items-center gap-2">
                <button
                  type="button"
                  data-book-trigger="true"
                  data-book-id={exp.id}
                  class="flex-1 sm:flex-none bg-gold-400 hover:bg-gold-500 text-neutral-950 font-mono text-xs uppercase tracking-wider font-bold px-6 py-3.5 rounded-sm transition-all shadow-md active:scale-95 cursor-pointer"
                >
                  {exp.buttonText || 'Book Now'}
                </button>

                <a
                  href={`https://wa.me/6281239633946?text=${encodeURIComponent(`Halo Gede Bali Trip, saya ingin booking paket tour *${exp.title}* ($${exp.pricePerCar}/mobil). Mohon konfirmasi jadwal. Terima kasih!`)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="p-3 bg-emerald-500 hover:bg-emerald-600 text-neutral-950 rounded-sm transition-all shadow-md"
                  title="Booking via WhatsApp"
                >
                  <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                    <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.669-.699c.969.54 1.771.82 2.791.82 3.181 0 5.767-2.586 5.768-5.766 0-3.18-2.587-5.766-5.768-5.766zm9.969 5.766c0 5.502-4.478 9.98-9.969 9.98-1.741 0-3.376-.452-4.802-1.242l-5.229 1.369 1.395-5.097c-.899-1.482-1.414-3.218-1.414-5.07 0-5.502 4.478-9.978 9.969-9.978 5.491 0 10.05 4.536 10.05 10.038z"/>
                  </svg>
                </a>
              </div>
            </div>

          </div>
        </div>
      ))}
    </div>

  </div>
</div>

<script is:inline>
  (function () {
    const filterBtns = document.querySelectorAll('.tour-filter-btn');
    const cards = document.querySelectorAll('.tour-card');

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const tab = btn.getAttribute('data-tab');

        filterBtns.forEach((b) => {
          b.classList.remove('bg-gold-400', 'text-neutral-950', 'font-bold');
          b.classList.add('text-gold-300/60');
        });
        btn.classList.add('bg-gold-400', 'text-neutral-950', 'font-bold');
        btn.classList.remove('text-gold-300/60');

        cards.forEach((card) => {
          const id = card.getAttribute('data-id');
          if (tab === 'all' || id === tab) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });
      });
    });
  })();
</script>
