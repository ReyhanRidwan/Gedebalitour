---
import { VEHICLES } from '../../data';
---

<section id="rental-home-section" class="py-24 bg-neutral-950 border-t border-gold-900/15 relative overflow-hidden">
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[500px] h-[500px] bg-gold-500/5 rounded-full blur-[120px] pointer-events-none"></div>
  
  <div class="max-w-7xl mx-auto px-6 md:px-12 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center space-x-2 bg-gold-400/10 border border-gold-400/20 px-3.5 py-1.5 rounded-full mb-4">
        <span class="w-2 h-2 rounded-full bg-gold-400 animate-pulse"></span>
        <span class="font-mono text-[10px] uppercase tracking-[0.25em] text-gold-300 font-bold">
          Premium Mobility Solutions
        </span>
      </div>
      <h2 class="font-serif text-3xl md:text-5xl text-gold-200 tracking-wide font-medium">
        Layanan Sewa Mobil & Motor Bali
      </h2>
      <p class="font-sans text-sm md:text-base text-gold-100/60 leading-relaxed mt-4">
        Jelajahi keindahan Bali dengan kebebasan penuh. Kami menyediakan armada mobil premium dan motor modis dengan opsi berkendara sendiri (lepas kunci) atau layanan supir VIP dengan bahan bakar.
      </p>
    </div>

    <!-- Filters and View All Header -->
    <div class="flex flex-col md:flex-row items-center justify-between gap-6 border-b border-gold-900/15 pb-6 mb-12">
      <div class="flex bg-neutral-900/80 p-1.5 rounded-md border border-gold-400/10 w-full md:w-auto">
        <span class="px-5 py-2.5 text-xs font-mono font-bold uppercase tracking-wider text-gold-400 flex items-center gap-2">
          <span>🚗</span>
          <span>Armada Transportasi Premium</span>
        </span>
      </div>

      <a
        href="/rental"
        class="flex items-center gap-2 text-xs font-mono uppercase tracking-[0.2em] font-bold text-gold-400 hover:text-gold-300 group transition-colors cursor-pointer"
      >
        <span>Lihat Semua Armada & Sewa</span>
        <span class="group-hover:translate-x-1.5 transition-transform">→</span>
      </a>
    </div>

    <!-- Grid Display -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {VEHICLES.map((vehicle) => {
        const hasSelfDrive = vehicle.priceWithoutDriverPerDay > 0;

        return (
          <div class="bg-neutral-900/40 border border-gold-900/15 hover:border-gold-400/40 rounded-lg overflow-hidden flex flex-col group transition-all duration-500 hover:-translate-y-1 hover:shadow-2xl hover:shadow-gold-500/5 text-left">
            <!-- Vehicle Image Container -->
            <div class="relative h-56 overflow-hidden bg-neutral-950">
              <img
                src={vehicle.image}
                alt={vehicle.name}
                loading="lazy"
                referrerpolicy="no-referrer"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
              />
              {vehicle.passengers && (
                <span class="absolute top-4 left-4 bg-neutral-950/95 backdrop-blur-md border border-gold-400/25 text-gold-300 font-mono text-[9px] uppercase tracking-wider font-bold py-1.5 px-3 rounded-sm shadow-md">
                  {vehicle.passengers} Penumpang
                </span>
              )}
              
              <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-neutral-950 via-neutral-950/45 to-transparent p-4 flex items-end justify-between">
                {hasSelfDrive ? (
                  <div>
                    <p class="text-[9px] uppercase font-mono tracking-widest text-gold-400/70">Lepas Kunci</p>
                    <p class="font-mono text-sm font-bold text-gold-100">
                      Rp {vehicle.priceWithoutDriverPerDay.toLocaleString('id-ID')} <span class="text-[9px] font-normal text-gold-100/50">/hari</span>
                    </p>
                  </div>
                ) : (
                  <div>
                    <p class="text-[9px] uppercase font-mono tracking-widest text-gold-400/70">Layanan</p>
                    <p class="font-mono text-xs font-semibold text-gold-200">VIP Supir + BBM</p>
                  </div>
                )}

                <div class="text-right">
                  <p class="text-[9px] uppercase font-mono tracking-widest text-gold-400">Dengan Supir + BBM</p>
                  <p class="font-mono text-base font-extrabold text-gold-400">
                    Rp {vehicle.priceWithDriverPerDay.toLocaleString('id-ID')} <span class="text-[9px] font-normal text-gold-100/50">/hari</span>
                  </p>
                </div>
              </div>
            </div>

            <!-- Vehicle Spec Details -->
            <div class="p-6 flex-grow flex flex-col justify-between space-y-6">
              <div>
                <h3 class="font-serif text-xl text-gold-100 font-medium group-hover:text-gold-300 transition-colors">
                  {vehicle.name}
                </h3>
                <p class="text-xs text-gold-200/60 font-sans leading-relaxed mt-2 line-clamp-2">
                  {vehicle.description}
                </p>

                <!-- Vehicle specs strip -->
                <div class="grid grid-cols-2 gap-2 mt-4 pt-4 border-t border-gold-900/10 text-[11px] font-mono text-gold-200/70">
                  <div class="flex items-center gap-1.5">
                    <span>⚙</span>
                    <span>{vehicle.transmission}</span>
                  </div>
                  <div class="flex items-center gap-1.5">
                    <span>⛽</span>
                    <span>{vehicle.engine}</span>
                  </div>
                </div>

                <!-- Features list -->
                <ul class="mt-4 space-y-1.5 text-xs text-gold-200/70 font-sans font-light">
                  {vehicle.features.slice(0, 3).map((feat) => (
                    <li class="flex items-center gap-2">
                      <span class="text-emerald-400 text-xs">✓</span>
                      <span>{feat}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Action button -->
              <div class="pt-4 border-t border-gold-900/15 flex items-center justify-between gap-3">
                <a
                  href={`/rental`}
                  class="flex-1 bg-gold-400 hover:bg-gold-500 text-neutral-950 font-mono text-[10px] uppercase tracking-wider font-bold py-3 text-center rounded-sm transition-all shadow-md active:scale-95"
                >
                  Detail & Sewa
                </a>
                
                <a
                  href={`https://wa.me/6281239633946?text=${encodeURIComponent(`Halo Gede Bali Trip, saya ingin rental mobil *${vehicle.name}*. Mohon info ketersediaan unitnya. Terima kasih!`)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="p-3 border border-emerald-500/40 hover:bg-emerald-500/10 text-emerald-400 rounded-sm transition-colors"
                  title="Hubungi via WhatsApp"
                >
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                    <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.669-.699c.969.54 1.771.82 2.791.82 3.181 0 5.767-2.586 5.768-5.766 0-3.18-2.587-5.766-5.768-5.766zm9.969 5.766c0 5.502-4.478 9.98-9.969 9.98-1.741 0-3.376-.452-4.802-1.242l-5.229 1.369 1.395-5.097c-.899-1.482-1.414-3.218-1.414-5.07 0-5.502 4.478-9.978 9.969-9.978 5.491 0 10.05 4.536 10.05 10.038z"/>
                  </svg>
                </a>
              </div>

            </div>

          </div>
        );
      })}
    </div>

  </div>
</section>
