---
import { VEHICLES } from '../../data';
---

<div class="pt-28 pb-24 px-4 sm:px-6 md:px-12 bg-neutral-950 min-h-screen text-gold-100 font-sans">
  <div class="max-w-7xl mx-auto">
    
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-14">
      <div class="inline-flex items-center space-x-2 bg-gold-400/10 border border-gold-400/20 px-4 py-1.5 rounded-full">
        <span class="w-2 h-2 rounded-full bg-gold-400 animate-pulse"></span>
        <span class="font-mono text-xs uppercase tracking-[0.25em] text-gold-400 font-bold">
          Sewa Mobil & Motor Bali
        </span>
      </div>
      <h1 class="font-serif text-3xl sm:text-4xl md:text-6xl text-gold-100 font-medium tracking-wide">
        Armada Sewa Kendaraan Terbaik
      </h1>
      <p class="font-sans text-sm md:text-base text-gold-200/70 leading-relaxed font-light max-w-2xl mx-auto">
        Kenyamanan dan keselamatan perjalanan Anda adalah komitmen utama kami. Seluruh unit terawat prima, bersih, ber-AC sejuk, dengan opsi lepas kunci atau supir profesional + BBM.
      </p>
    </div>

    <!-- Filter & Search Bar -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mb-10 pb-6 border-b border-gold-900/15">
      <div class="inline-flex p-1 bg-neutral-900 border border-gold-400/20 rounded-lg">
        <button
          type="button"
          class="vehicle-filter-btn px-5 py-2.5 rounded-md text-xs font-mono font-bold uppercase tracking-wider transition-all bg-gold-400 text-neutral-950 cursor-pointer"
          data-type="all"
        >
          Semua Armada ({VEHICLES.length})
        </button>
        <button
          type="button"
          class="vehicle-filter-btn px-5 py-2.5 rounded-md text-xs font-mono font-semibold uppercase tracking-wider transition-all text-gold-300/60 hover:text-gold-200 cursor-pointer"
          data-type="car"
        >
          Mobil
        </button>
      </div>

      <!-- Quick Contact Info -->
      <div class="flex items-center gap-2 text-xs font-mono text-gold-400">
        <span>✓ Unit Bersih & Wangi</span>
        <span>•</span>
        <span>✓ BBM Termasuk (Opsi Supir)</span>
      </div>
    </div>

    <!-- Vehicles Catalog Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="vehicles-catalog-grid">
      {VEHICLES.map((vehicle) => {
        const hasSelfDrive = vehicle.priceWithoutDriverPerDay > 0;

        return (
          <div
            class="vehicle-catalog-card bg-neutral-900/40 border border-gold-900/15 hover:border-gold-400/40 rounded-xl overflow-hidden flex flex-col group transition-all duration-500 hover:-translate-y-1 hover:shadow-2xl hover:shadow-gold-500/5 text-left"
            data-type={vehicle.type}
            data-name={vehicle.name}
          >
            <!-- Image Container -->
            <div class="relative h-60 overflow-hidden bg-neutral-950">
              <img
                src={vehicle.image}
                alt={vehicle.name}
                loading="lazy"
                referrerpolicy="no-referrer"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
              />
              {vehicle.passengers && (
                <span class="absolute top-4 left-4 bg-neutral-950/95 backdrop-blur-md border border-gold-400/25 text-gold-300 font-mono text-[9px] uppercase tracking-wider font-bold py-1.5 px-3 rounded-sm shadow-md">
                  {vehicle.passengers} Kursi Penumpang
                </span>
              )}
              
              <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-neutral-950 via-neutral-950/50 to-transparent p-4 flex items-end justify-between">
                {hasSelfDrive ? (
                  <div>
                    <p class="text-[9px] uppercase font-mono tracking-widest text-gold-400/70">Lepas Kunci</p>
                    <p class="font-mono text-sm font-bold text-gold-100">
                      Rp {vehicle.priceWithoutDriverPerDay.toLocaleString('id-ID')} <span class="text-[9px] font-normal text-gold-100/50">/hari</span>
                    </p>
                  </div>
                ) : (
                  <div>
                    <p class="text-[9px] uppercase font-mono tracking-widest text-gold-400/70">Layanan</p>
                    <p class="font-mono text-xs font-semibold text-gold-200">VIP Supir + BBM</p>
                  </div>
                )}

                <div class="text-right">
                  <p class="text-[9px] uppercase font-mono tracking-widest text-gold-400">Dengan Supir + BBM</p>
                  <p class="font-mono text-base font-extrabold text-gold-400">
                    Rp {vehicle.priceWithDriverPerDay.toLocaleString('id-ID')} <span class="text-[9px] font-normal text-gold-100/50">/hari</span>
                  </p>
                </div>
              </div>
            </div>

            <!-- Body info -->
            <div class="p-6 flex-grow flex flex-col justify-between space-y-6">
              <div>
                <h2 class="font-serif text-xl text-gold-100 font-medium group-hover:text-gold-300 transition-colors">
                  {vehicle.name}
                </h2>
                <p class="text-xs text-gold-200/60 font-sans leading-relaxed mt-2 line-clamp-2">
                  {vehicle.description}
                </p>

                <!-- Specs row -->
                <div class="grid grid-cols-2 gap-2 mt-4 pt-4 border-t border-gold-900/10 text-[11px] font-mono text-gold-200/70">
                  <div class="flex items-center gap-1.5">
                    <span>⚙ Transmisi:</span>
                    <span class="text-gold-100">{vehicle.transmission}</span>
                  </div>
                  <div class="flex items-center gap-1.5">
                    <span>⛽ Mesin:</span>
                    <span class="text-gold-100">{vehicle.engine}</span>
                  </div>
                </div>

                <!-- Features list -->
                <ul class="mt-4 space-y-1 text-xs text-gold-200/70 font-sans">
                  {vehicle.features.map((feat) => (
                    <li class="flex items-center gap-2">
                      <span class="text-emerald-400 text-xs">✓</span>
                      <span>{feat}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Rental Actions -->
              <div class="pt-4 border-t border-gold-900/15 flex items-center justify-between gap-3">
                <a
                  href={`https://wa.me/6281239633946?text=${encodeURIComponent(`Halo Tim Gede Bali Trip, saya ingin menyewa armada *${vehicle.name}* (Rp ${vehicle.priceWithDriverPerDay.toLocaleString('id-ID')}/hari). Mohon info ketersediaan unitnya. Terima kasih!`)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex-1 bg-gold-400 hover:bg-gold-500 text-neutral-950 font-mono text-xs uppercase tracking-wider font-bold py-3.5 text-center rounded-sm transition-all shadow-md active:scale-95 flex items-center justify-center gap-2"
                >
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                    <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.669-.699c.969.54 1.771.82 2.791.82 3.181 0 5.767-2.586 5.768-5.766 0-3.18-2.587-5.766-5.768-5.766zm9.969 5.766c0 5.502-4.478 9.98-9.969 9.98-1.741 0-3.376-.452-4.802-1.242l-5.229 1.369 1.395-5.097c-.899-1.482-1.414-3.218-1.414-5.07 0-5.502 4.478-9.978 9.969-9.978 5.491 0 10.05 4.536 10.05 10.038z"/>
                  </svg>
                  <span>Sewa via WhatsApp</span>
                </a>
              </div>

            </div>
          </div>
        );
      })}
    </div>

  </div>
</div>

<script is:inline>
  (function () {
    const filterBtns = document.querySelectorAll('.vehicle-filter-btn');
    const cards = document.querySelectorAll('.vehicle-catalog-card');

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const type = btn.getAttribute('data-type');

        filterBtns.forEach((b) => {
          b.classList.remove('bg-gold-400', 'text-neutral-950', 'font-bold');
          b.classList.add('text-gold-300/60');
        });
        btn.classList.add('bg-gold-400', 'text-neutral-950', 'font-bold');
        btn.classList.remove('text-gold-300/60');

        cards.forEach((card) => {
          const cardType = card.getAttribute('data-type');
          if (type === 'all' || cardType === type) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });
      });
    });
  })();
</script>
